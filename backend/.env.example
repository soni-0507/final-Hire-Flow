PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hiring_pipeline
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Development-only conveniences. In production the app refuses to start with these defaults.
RECRUITER_INVITE_CODE=JOIN-RECRUITERS
SHOW_RESET_LINK=false

# Real email delivery: new accounts must verify a 6-digit code before login.
# Gmail: use an App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=HireFlow <your-email@gmail.com>
EMAIL_VERIFICATION_EXPIRES_MINUTES=15

# Email/domain screening (signup still requires mailbox verification)
# Disposable domains are blocked automatically. DNS/MX validation runs in production.

# Free hosting (Render etc.) blocks SMTP. Set this instead of the SMTP_* lines (Brevo -> SMTP & API -> API keys).
# MAIL_FROM must be a sender you verified in Brevo.
BREVO_API_KEY=
