# Copy to .env (next to docker-compose.yml) and change ALL of these before running.
# Generate a secret with:  openssl rand -hex 32
JWT_SECRET=replace-me-with-a-random-string-of-32-plus-characters
# The code recruiters must enter at signup. Choose your own and keep it private.
RECRUITER_INVITE_CODE=replace-me
# Shows the password-reset link on screen (keep false on public deployments).
# Keep false unless the app is only reachable by you.
SHOW_RESET_LINK=false

# Real email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=HireFlow <your-email@gmail.com>
EMAIL_VERIFICATION_EXPIRES_MINUTES=15

# Public deployment only: your domain (DNS A record must point at the server)
DOMAIN=hire.example.com
